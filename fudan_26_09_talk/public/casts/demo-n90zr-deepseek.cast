[87.88868, "o", "\u001b[0m$ \u001b[0mcd /Users/jinlei/fusion-demo/n90zr/work && for e in 24 50 55; do echo \"=== $e MeV ===\"; /Users/jinlei/Desktop/code/FUSION/skills/fresco/scripts/run_fresco.sh n90zr_$e.in n90zr_$e; done\r\n=== 24 MeV ===\r\n# run dir : /var/folders/hv/g3sqr4z92cs_s38_dsphydym0000gn/T//fresco-runs/n90zr_24\r\n# binary  : /Users/jinlei/bin/fresco\r\n# runtime : 0.04s\r\n# --- integrated cross sections (last energy) ---\r\n0CUMULATIVE REACTION cross section                 = 1619.02131  <L> =     5.29  <L**2> =     32.4\r\n0CUMULATIVE outgoing cross sections in partition 1 :    0.00000\r\n0Cumulative ABSORBTION by Imaginary Potentials     = 1619.02131  <L> =     5.29  <L**2> =     32.4\r\n0CUMULATIVE OUTGOING cross section                 =    0.00000\r\n# full output: /var/folders/hv/g3sqr4z92cs_s38_dsphydym0000gn/T//fresco-runs/n90zr_24/out   (fort.* files also in /var/folders/hv/g3sqr4z92cs_s38_dsphydym0000gn/T//fresco-runs/n90zr_24)\r\n=== 50 MeV ===\r\n# run dir : /var/folders/hv/g3sqr4z92cs_s38_dsphydym0000gn/T//fresco-runs/n90zr_50\r\n# b"]
[87.888693, "o", "inary  : /Users/jinlei/bin/fresco\r\n# runtime : 0.03s\r\n# --- integrated cross sections (last energy) ---\r\n0CUMULATIVE REACTION cross section                 = 1299.18965  <L> =     6.94  <L**2> =     55.9\r\n0CUMULATIVE outgoing cross sections in partition 1 :    0.00000\r\n0Cumulative ABSORBTION by Imaginary Potentials     = 1299.18965  <L> =     6.94  <L**2> =     55.9\r\n0CUMULATIVE OUTGOING cross section                 =    0.00000\r\n# full output: /var/folders/hv/g3sqr4z92cs_s38_dsphydym0000gn/T//fresco-runs/n90zr_50/out   (fort.* files also in /var/folders/hv/g3sqr4z92cs_s38_dsphydym0000gn/T//fresco-runs/n90zr_50)\r\n=== 55 MeV ===\r\n# run dir : /var/folders/hv/g3sqr4z92cs_s38_dsphydym0000gn/T//fresco-runs/n90zr_55\r\n# binary  : /Users/jinlei/bin/fresco\r\n# runtime : 0.03s\r\n# --- integrated cross sections (last energy) ---\r\n0CUMULATIVE REACTION cross section                 = 1255.74431  <L> =     7.17  <L**2> =     59.9\r\n0CUMULATIVE outgoing cross sections in partition 1 :    0.00000\r\n0Cumulative ABSORBTION by Ima"]
