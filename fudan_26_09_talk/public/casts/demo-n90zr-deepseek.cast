[11.418846, "o", "\u001b[0m\r\n\u001b[0m$ \u001b[0mpython3 scripts/exfor.py list 13160\r\nTITLE: NEUTRON SCATTERING FROM 90,91,92,94ZR\r\n\r\nSUBENT           N  ENERGY (as given)            REACTION\r\n----------------------------------------------------------------------------------------------------\r\n13160001         0  -                            -\r\n13160002        37  8.0                          (40-ZR-90(N,EL)40-ZR-90,,DA)\r\n13160003        36  10.0                         (40-ZR-90(N,EL)40-ZR-90,,DA)\r\n13160004        39  24.0                         (40-ZR-90(N,EL)40-ZR-90,,DA)\r\n13160005       100  8.0                          (40-ZR-90(N,INL)40-ZR-90,PAR,DA)\r\n13160006        52  24.0                         (40-ZR-90(N,INL)40-ZR-90,PAR,DA)\r\n13160007        36  8.0                          (40-ZR-91(N,EL)40-ZR-91,,DA)\r\n13160008        35  10.0                         (40-ZR-91(N,EL)40-ZR-91,,DA)\r\n13160009        35  24.0                         (40-ZR-91(N,EL)40-ZR-91,,DA)\r\n13160010        81  8.0                          (40-ZR-91(N,INL)40-ZR"]
