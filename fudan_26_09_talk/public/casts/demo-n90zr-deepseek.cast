[100.741914, "o", "\u001b[0m$ \u001b[0mcd /var/folders/hv/g3sqr4z92cs_s38_dsphydym0000gn/T/fresco-runs && cp -r n90zr_50 n90zr_50_conv && cd n90zr_50_conv && sed 's/hcm=0.05 rmatch=60/hcm=0.02 rmatch=80/' in > in2 && /Users/jinlei/bin/fresco < in2 > out2 2>&1; grep -i \"CUMULATIVE REACTION\" out2\r\n0CUMULATIVE REACTION cross section                 = 1299.18963  <L> =     6.94  <L**2> =     55.9\r\n\u001b[0m\r\n"]
[115.298783, "o", "\u001b[0m$ \u001b[0mcd /var/folders/hv/g3sqr4z92cs_s38_dsphydym0000gn/T/fresco-runs/n90zr_50_conv && sed 's/massp=1.00 zp=0/massp=1.008665 zp=0/; s/masst=90.0000 zt=40/masst=89.9047 zt=40/' in2 > in3 && /Users/jinlei/bin/fresco < in3 > out3 2>&1; grep -i \"CUMULATIVE REACTION\" out3\r\n0CUMULATIVE REACTION cross section                 = 1301.63908  <L> =     6.97  <L**2> =     56.4\r\n\u001b[0m\r\n"]
[131.340242, "o", "\u001b[0m← \u001b[0mEdit work/n90zr_50.in\r\nIndex: /Users/jinlei/fusion-demo/n90zr/work/n90zr_50.in\r\n===================================================================\r\n--- /Users/jinlei/fusion-demo/n90zr/work/n90zr_50.in\r\n+++ /Users/jinlei/fusion-demo/n90zr/work/n90zr_50.in\r\n@@ -5,10 +5,10 @@\r\n  thmin=0.00 thmax=180.00 thinc=1.00\r\n \t chans=1 smats=2  xstabl=1\r\n  elab(1)=50.0 nlab(1)=1 /\r\n \r\n-&PARTITION namep='n' massp=1.00 zp=0\r\n-\t    namet='Zr90' masst=90.0000 zt=40 qval=-0.000 nex=1  /\r\n+&PARTITION namep='n' massp=1.008665 zp=0\r\n+\t    namet='Zr90' masst=89.904704 zt=40 qval=-0.000 nex=1  /\r\n &STATES jp=0.5 bandp=1 ep=0.0000 cpot=1 jt=0.0 bandt=1 et=0.0000  /\r\n &partition /\r\n \r\n &POT kp=1 type=0 ap=0.000 at=90.000 rc=1.200000 /\r\n\r\n\u001b[0m\r\n"]
