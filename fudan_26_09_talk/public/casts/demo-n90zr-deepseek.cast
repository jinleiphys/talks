[152.694735, "o", "\u001b[0m$ \u001b[0mcd /Users/jinlei/Desktop/code/FUSION/skills/exfor-data && python3 scripts/exfor.py data 13160004 > /Users/jinlei/fusion-demo/n90zr/work/exfor_24.txt 2>/dev/null && python3 scripts/exfor.py data 22480005 --energy 55 > /Users/jinlei/fusion-demo/n90zr/work/exfor_55.txt 2>/dev/null; echo done; head -3 /Users/jinlei/fusion-demo/n90zr/work/exfor_55.txt\r\ndone\r\n# REACTION: (40-ZR-0(N,EL)40-ZR-0,,DA)\r\n# SAMPLE: .Natural Zirconium, Cylinder 3 cm Diam, 5 cm Long Placed 10 M from the Target\r\n# columns: EN [MEV] | ANG-CM [ADEG] | ANG-ERR [ADEG] | DATA [MB/SR] | DATA-ERR [MB/SR]\r\n\u001b[0m\r\n"]
[158.982516, "o", "\u001b[0m$ \u001b[0mcd /Users/jinlei/fusion-demo/n90zr/work && echo \"=== exfor_55.txt (first 8 data lines) ===\" && grep -v '^#' exfor_55.txt | head -8 && echo \"=== exfor_24.txt (first 5 data lines) ===\" && grep -v '^#' exfor_24.txt | head -5\r\n=== exfor_55.txt (first 8 data lines) ===\r\n55.\t2.6\t0.71\t1.7084E+04\t3.0381E+03\r\n55.\t4.7\t0.71\t1.4514E+04\t1.2763E+03\r\n55.\t5.4\t0.72\t1.3970E+04\t1.1420E+03\r\n55.\t7.4\t0.72\t1.0794E+04\t8.7054E+02\r\n55.\t8.1\t0.72\t9.7560E+03\t7.5154E+02\r\n55.\t10.1\t0.72\t7.2949E+03\t5.7258E+02\r\n55.\t10.8\t0.72\t5.3020E+03\t4.2858E+02\r\n55.\t11.2\t1.17\t5.4013E+03\t4.0518E+02\r\n=== exfor_24.txt (first 5 data lines) ===\r\n15.3\t1453.27\t43.60\r\n18.2\t746.68\t22.40\r\n21.2\t396.83\t11.90\r\n24.3\t193.21\t6.80\r\n26.3\t120.51\t18.08\r\n\u001b[0m\r\n"]
