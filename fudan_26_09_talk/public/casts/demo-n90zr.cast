[297.628275, "o", "\u001b[0m\r\n\u001b[0m$ \u001b[0mcd \"/private/tmp/claude-501/-Users-jinlei-Desktop-code-fusion-web/922a803a-fd57-4b6b-bf73-9dbb21f2e019/scratchpad/demo2b/work\" && cat -v exfor_13160004_24MeV.dat | head -12 && echo \"====55====\" && cat -v exfor_22480005_55MeV.dat | head -8\r\n# REACTION: (40-ZR-90(N,EL)40-ZR-90,,DA)\r\n# SAMPLE: ISOTOPIC COMPOSITION OF SAMPLE: 97.7% 90-ZR, 1% 91-ZR, AND ABOUT 0.5% OF 92-ZR AND 94-ZR\r\n# INC-SOURCE: (D-T)\r\n# COMMON EN = 24.0 MEV\r\n# COMMON EN-RSL = 0.410 MEV\r\n# columns: ANG-CM [ADEG] | DATA-CM [MB/SR] | DATA-ERR [MB/SR]\r\n15.3\t1453.27\t43.60\r\n18.2\t746.68\t22.40\r\n21.2\t396.83\t11.90\r\n24.3\t193.21\t6.80\r\n26.3\t120.51\t18.08\r\n28.3\t86.66\t17.33\r\n====55====\r\n# REACTION: (40-ZR-0(N,EL)40-ZR-0,,DA)\r\n# SAMPLE: .Natural Zirconium, Cylinder 3 cm Diam, 5 cm Long Placed 10 M from the Target\r\n# columns: EN [MEV] | ANG-CM [ADEG] | ANG-ERR [ADEG] | DATA [MB/SR] | DATA-ERR [MB/SR]\r\n55.\t2.6\t0.71\t1.7084E+04\t3.0381E+03\r\n55.\t4.7\t0.71\t1.4514E+04\t1.2763E+03\r\n55.\t5.4\t0.72\t1.3970E+04\t1.1420E+03\r\n55.\t7.4\t0.72\t1.0794E+04\t8.7054E+02\r\n55."]
